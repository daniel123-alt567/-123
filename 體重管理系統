/* 導覽列樣式 */
.nav-bar {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 20px;
    flex-wrap: wrap;
}

.nav-link {
    text-decoration: none;
    color: #495057;
    padding: 8px 16px;
    border-radius: 4px;
    background-color: #f8f9fa;
    border: 1px solid #dee2e6;
    font-size: 0.95rem;
    transition: background-color 0.2s;
}

.nav-link:hover {
    background-color: #e9ecef;
}

.nav-link.active {
    background-color: #4a90e2;
    color: #ffffff;
    border-color: #4a90e2;
}
